<Window x:Class="DHBIMWATER.UI.Views.Documentation.Sheets.ViewTemplateSelectView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:behaviors="clr-namespace:DHBIMWATER.UI.Behaviors"
        behaviors:DialogResultBehavior.DialogResult="{Binding DialogResult}"
        mc:Ignorable="d"
        Title="뷰 템플릿 선택"
        Height="360" Width="250"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F9"
        AllowsTransparency="False"
        WindowStyle="None"
        FontFamily="Segoe UI, Malgun Gothic">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0"/>

        <!-- Top: Buttons -->
        <Grid Grid.Row="1" Margin="10,5,10,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="65"/>
                <RowDefinition Height="65"/>
                <RowDefinition Height="65"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="평면도 뷰 템플릿"
                               Margin="0,5,0,5"
                               Foreground="{Binding TextBlock}"/>
                    <ComboBox  d:ItemsSource="{d:SampleData ItemCount=1}"
                               Width="230" Height="35"
                               Margin="0,0,0,10"
                               ItemsSource="{Binding PlanTemplates}"
                               SelectedItem="{Binding SelectedPlanTemplate}"
                               DisplayMemberPath="Name"
                               Style="{StaticResource PrimaryComboBoxStyle}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="단면도 뷰 템플릿"
                               Margin="0,5,0,5"
                               Foreground="{Binding TextBlock}"/>
                    <ComboBox  d:ItemsSource="{d:SampleData ItemCount=1}"
                               Width="230" Height="35"
                               Margin="0,0,0,10"
                               ItemsSource="{Binding SectionTemplates}"
                               SelectedItem="{Binding SelectedSectionTemplate}"
                               DisplayMemberPath="Name"
                               Style="{StaticResource PrimaryComboBoxStyle}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="평면도 축척"
                               Margin="0,5,0,5"
                               Foreground="{Binding TextBlock}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  d:ItemsSource="{d:SampleData ItemCount=1}"
                                  Width="125" Height="35"
                                  ItemsSource="{Binding ScaleOptions}"
                                  SelectedItem="{Binding SelectedPlanScaleOption}"
                                  Style="{StaticResource PrimaryComboBoxStyle}"/>
                        <TextBox Grid.Column="1"
                                 Width="95" Height="35"
                                 Margin="5,0,0,0"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 IsEnabled="{Binding IsPlanScaleCustomEnabled}"
                                 Text="{Binding PlanScaleCustomValue, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="단면도 축척"
                               Margin="0,5,0,5"
                               Foreground="{Binding TextBlock}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  d:ItemsSource="{d:SampleData ItemCount=1}"
                                  Width="125" Height="35"
                                  ItemsSource="{Binding ScaleOptions}"
                                  SelectedItem="{Binding SelectedSectionScaleOption}"
                                  Style="{StaticResource PrimaryComboBoxStyle}"/>
                        <TextBox Grid.Column="1"
                                 Width="95" Height="35"
                                 Margin="5,0,0,0"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 IsEnabled="{Binding IsSectionScaleCustomEnabled}"
                                 Text="{Binding SectionScaleCustomValue, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" HorizontalAlignment="Center" Margin="0,10,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="OK"
                        Width="80" FontSize="15" Margin="0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ConfirmCommand}"
                        IsDefault="True"/>

                <Button Grid.Column="1" Content="Cancel"
                        Width="80" FontSize="15" Margin="5,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
