<Window x:Class="DHBIMWATER.UI.Views.Modeling.AlignmentFamilyPlacementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls" Title="선형 패밀리 배치" Width="680" Height="560" WindowStartupLocation="CenterScreen" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" Background="#F4F7F9">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:TitleBar Grid.Row="0"/>
        <Border Grid.Row="1" Background="White" CornerRadius="15" Margin="20,12" Padding="18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="파일 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}"/>
                    <Button Content="제거" Style="{StaticResource CancelButtonStyle}" Margin="8,0,0,0" Command="{Binding RemoveCommand}"/>
                </StackPanel>
                <ListBox Style="{StaticResource PrimaryListBoxStyle}" Height="135" Margin="0,10,0,14" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FileName}" Width="320"/>
                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding PipeKind, UpdateSourceTrigger=PropertyChanged}" Width="180" ToolTip="파일별 관종"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <GroupBox Header="배치 설정" Style="{StaticResource PrimaryGroupBox}">
                    <StackPanel Margin="12">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="빔 패밀리" IsChecked="{Binding IsBeamTarget}" GroupName="Target"/>
                            <RadioButton Content="파이프 시스템" Margin="18,0,0,0" IsChecked="{Binding IsPipingTarget}" GroupName="Target"/>
                        </StackPanel>
                        <TextBlock Text="대상 유형" Margin="0,10,0,3"/>
                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding TargetTypeNames}" SelectedItem="{Binding SelectedTargetTypeName}"/>
                        <StackPanel Visibility="{Binding IsPipingTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="PipeType" Margin="0,10,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipeTypeNames}" SelectedItem="{Binding PipeTypeName}"/>
                        </StackPanel>
                        <TextBlock Text="레벨" Margin="0,10,0,3"/>
                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding LevelNames}" SelectedItem="{Binding LevelName}"/>
                        <TextBlock Text="배치 간격 (m)" Margin="0,10,0,3"/>
                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding IntervalM, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Content="선형 접선 방향 회전" Style="{StaticResource PrimaryCheckBoxStyle}" Margin="0,10,0,0" IsChecked="{Binding AlignTangent}" Visibility="{Binding IsBeamTarget, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <Button Content="취소" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
            <Button Content="배치 생성" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateCommand}"/>
        </StackPanel>
    </Grid>
</Window>
