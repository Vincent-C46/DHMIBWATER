<Window x:Class="DHBIMWATER.UI.Views.Modeling.PipeAlignmentModelingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls" xmlns:converters="clr-namespace:DHBIMWATER.UI.Converters" xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling" Title="관로 모델링" Width="960" Height="700" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" Background="#F4F7F9">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibility"/>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:TitleBar/>
        <Border Grid.Row="1" Background="White" CornerRadius="15" Margin="20,12" Padding="18">
            <TabControl Style="{StaticResource PrimaryTabControlStyle}">
                <TabItem Header="입력·기준점">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="파일 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}"/>
                            <Button Content="제거" Style="{StaticResource CancelButtonStyle}" Margin="8,0" Command="{Binding RemoveCommand}"/>
                            <TextBlock Margin="18,5,0,0" Foreground="#B26B00" Text="{Binding DiameterUnresolvedCount, StringFormat=⚠ 직경 미확인 {0}건}" Visibility="{Binding HasDiameterUnresolved, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,10">
                            <Grid.Resources>
                                <Style x:Key="FileGridRowStyle" TargetType="RowDefinition">
                                    <Setter Property="Height" Value="*"/>
                                    <Setter Property="MinHeight" Value="120"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition>
                                    <RowDefinition.Style>
                                        <Style TargetType="RowDefinition" BasedOn="{StaticResource FileGridRowStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasShpFiles}" Value="False">
                                                    <Setter Property="Height" Value="0"/>
                                                    <Setter Property="MinHeight" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RowDefinition.Style>
                                </RowDefinition>
                                <RowDefinition>
                                    <RowDefinition.Style>
                                        <Style TargetType="RowDefinition" BasedOn="{StaticResource FileGridRowStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDwgFiles}" Value="False">
                                                    <Setter Property="Height" Value="0"/>
                                                    <Setter Property="MinHeight" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RowDefinition.Style>
                                </RowDefinition>
                                <RowDefinition>
                                    <RowDefinition.Style>
                                        <Style TargetType="RowDefinition" BasedOn="{StaticResource FileGridRowStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasExcelFiles}" Value="False">
                                                    <Setter Property="Height" Value="0"/>
                                                    <Setter Property="MinHeight" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RowDefinition.Style>
                                </RowDefinition>
                            </Grid.RowDefinitions>
                            <!-- 불러온 소스 종류별 그리드를 세로로 모두 표시한다. -->
                            <ScrollViewer Grid.Row="0" Margin="0,0,0,8" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasShpFiles, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid ItemsSource="{Binding ShpFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일 (SHP)" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                    <DataGridTemplateColumn Header="직경 필드(DBF)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding DiameterField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="직경(mm, 수동)" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ManualDiameterMm, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding DiameterField, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PipeAlignmentSourceFileItem.ManualFieldOption}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관종 필드(DBF)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding KindField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관종(수동)" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipeKinds, Mode=OneWay}" SelectedItem="{Binding PipeKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding KindField, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PipeAlignmentSourceFileItem.ManualFieldOption}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            </ScrollViewer>
                            <ScrollViewer Grid.Row="1" Margin="0,0,0,8" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasDwgFiles, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid ItemsSource="{Binding DwgFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일 (DWG·DXF)" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                    <DataGridTemplateColumn Header="직경 필드(XDATA)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding DiameterField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="직경(mm, 수동)" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ManualDiameterMm, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding DiameterField, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PipeAlignmentSourceFileItem.ManualFieldOption}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관종 필드(XDATA)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding KindField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관종(수동)" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipeKinds, Mode=OneWay}" SelectedItem="{Binding PipeKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding KindField, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PipeAlignmentSourceFileItem.ManualFieldOption}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            </ScrollViewer>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasExcelFiles, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid ItemsSource="{Binding ExcelFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일 (Excel, 시트별)" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                    <DataGridTemplateColumn Header="직경 필드" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding DiameterField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="직경(mm, 수동)" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ManualDiameterMm, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding DiameterField, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PipeAlignmentSourceFileItem.ManualFieldOption}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관종 필드" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding KindField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관종(수동)" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipeKinds, Mode=OneWay}" SelectedItem="{Binding PipeKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding KindField, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PipeAlignmentSourceFileItem.ManualFieldOption}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            </ScrollViewer>
                        </Grid>
                        <StackPanel Grid.Row="2">
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding SelectedFileDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="80"/>
                            <StackPanel Visibility="{Binding IsSelectedFileDwg, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Margin="0,8,0,3" Text="사용할 폴리선 레이어 (복수 선택 가능)"/>
                                <ListBox ItemsSource="{Binding SelectedFile.LayerOptions}" MaxHeight="100" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ProjectionDetails, Mode=OneWay}" IsReadOnly="True" Height="60" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,8,0,3" Text="평면 기준점 X·Y (m, 소수 5자리=0.01mm) — 첫 파일 첫 정점에서 자동 산출하며 수정할 수 있습니다. 이 점이 프로젝트 기준점에 놓이고, 높이는 정점 Z값으로만 결정됩니다."/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="170" Text="{Binding ReferenceX, StringFormat={}{0:0.00000}}"/>
                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="170" Margin="8,0" Text="{Binding ReferenceY, StringFormat={}{0:0.00000}}"/>
                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" Width="140" Margin="8,0" ItemsSource="{Binding ZDatums}" SelectedItem="{Binding ZDatum}"/>
                            </StackPanel>
                            <CheckBox Content="프로젝트 공유좌표에도 기준점 적용" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding ApplySharedCoordinates}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="모델 유형 선택">
                    <StackPanel Margin="16">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="DirectShape (선형 형상)" IsChecked="{Binding IsDirectShape}" GroupName="Output"/>
                            <RadioButton Content="가변 패밀리 (직관 2점 + 곡관 5점)" Margin="18,0" IsChecked="{Binding IsAdaptive}" GroupName="Output"/>
                            <RadioButton Content="파이프 (MEP)" Margin="18,0" IsChecked="{Binding IsPiping}" GroupName="Output"/>
                        </StackPanel>
                        <TextBlock Margin="0,16,0,5" Text="DirectShape는 선형 전체를 생성하고 DH_* 공유매개변수를 기록합니다." Visibility="{Binding IsDirectShape, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Visibility="{Binding IsAdaptive, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="직관 패밀리 (2점 가변)"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightFamilyNames, Mode=OneWay}" SelectedItem="{Binding StraightFamilyName, Mode=TwoWay}"/>
                            <TextBlock Text="유형" Margin="0,8,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightTypeNames, Mode=OneWay}" SelectedItem="{Binding StraightTypeName, Mode=TwoWay}" ToolTip="직관은 Adaptive Point가 2개인 유형이어야 합니다."/>
                            <TextBlock Foreground="#B26B00" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding StraightPointCountNotice}" Visibility="{Binding HasStraightPointCountNotice, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="호칭지름 파라미터" Margin="0,8,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightParameterOptions}" SelectedItem="{Binding StraightDiameterParameterName}" ToolTip="직관 패밀리 선택 시 후보 이름으로 자동 매칭을 시도합니다. 필요하면 직접 선택하세요."/>
                            <TextBlock Text="관종 파라미터" Margin="0,8,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightParameterOptions}" SelectedItem="{Binding StraightKindParameterName}" ToolTip="직관 패밀리 선택 시 후보 이름으로 자동 매칭을 시도합니다. 필요하면 직접 선택하세요."/>
                            <TextBlock Text="외경 OD 파라미터" Margin="0,8,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightParameterOptions, Mode=OneWay}" SelectedItem="{Binding StraightOuterDiameterParameterName, Mode=TwoWay}"/>
                            <TextBlock Text="직관 두께 파라미터" Margin="0,8,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightParameterOptions, Mode=OneWay}" SelectedItem="{Binding StraightThicknessParameterName, Mode=TwoWay}"/>
                            <TextBlock Text="배치 간격 (m)" Margin="0,8,0,3"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding IntervalM}" Width="150" HorizontalAlignment="Left" ToolTip="직관을 이 간격으로 분절해 배치합니다. 곡관이 들어가는 정점에서는 그 자리만큼 직관을 만들지 않습니다."/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsPiping, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="파이프 시스템"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipingSystemTypeNames}" SelectedItem="{Binding PipingSystemTypeName}"/>
                            <TextBlock Margin="0,8,0,0" Text="PipeType"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipeTypeNames}" SelectedItem="{Binding PipeTypeName}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsDirectShape, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="레벨" Margin="0,12,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding LevelNames}" SelectedItem="{Binding LevelName}"/>
                            <!-- 배치 간격은 DirectShape에서 쓰지 않아(선형 전체를 그대로 형상화) 가변 패밀리 패널로 옮겼다. -->

                        </StackPanel>
                    </StackPanel>
                </TabItem>
                <TabItem Header="관 · 곡관 설정" Visibility="{Binding IsAdaptive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="12">
                        <TextBlock Foreground="#B26B00" Text="{Binding SettingsNotice}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <Button Content="관·곡관 규격표…" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenPipeSpecsCommand}"/>
                            <Button Content="허용굴곡 설정…" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0" Command="{Binding OpenJointSettingsCommand}"/>
                            <Button Content="설정 저장" Style="{StaticResource PrimaryButtonStyle}" Margin="18,0" Command="{Binding SaveCommand}"/>
                        </StackPanel>
                        <TextBlock Text="곡관 패밀리 (5점 가변)" Margin="0,14,0,3"/>
                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding BendFamilyNames, Mode=OneWay}" SelectedItem="{Binding BendFamilyName, Mode=TwoWay}"/>
                        <TextBlock Text="호칭지름 DN 파라미터" Margin="0,8,0,3"/>
                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding BendParameterOptions, Mode=OneWay}" SelectedItem="{Binding BendDiameterParameterName, Mode=TwoWay}"/>
                        <TextBlock Text="곡관 벽두께(e) 파라미터" Margin="0,8,0,3"/>
                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding BendParameterOptions, Mode=OneWay}" SelectedItem="{Binding BendWallThicknessParameterName, Mode=TwoWay}"/>
                    </StackPanel>
                </TabItem>
                <!-- 진단 탭: 임시 숨김. 다시 노출하려면 Visibility 속성 제거 -->
                <TabItem Header="진단" Visibility="Collapsed">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="스냅 허용오차(mm)" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="70" Margin="8,0" Text="{Binding SnapToleranceMm}"/>
                            <TextBlock Text="곡관 형식" VerticalAlignment="Center"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" Width="100" Margin="8,0" ItemsSource="{Binding Forms}" SelectedItem="{Binding Form}"/>
                            <Button Content="진단 실행" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0" Command="{Binding RunCommand}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Margin="0,12,0,6" Text="{Binding Summary}" TextWrapping="Wrap"/>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Attention}" IsReadOnly="True" AutoGenerateColumns="True"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <Button Content="취소" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
            <Button Content="모델 생성" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateCommand}"/>
        </StackPanel>
    </Grid>
</Window>
