<Window x:Class="DHBIMWATER.UI.Views.Modeling.PipeAlignmentModelingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls" xmlns:converters="clr-namespace:DHBIMWATER.UI.Converters" xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling" Title="관로 모델링" Width="960" Height="700" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" Background="#F4F7F9">
    <Window.Style>
        <Style TargetType="{x:Type Window}">
            <Setter Property="SizeToContent" Value="Height"/>
            <Setter Property="MaxHeight" Value="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"/>
        </Style>
    </Window.Style>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibility"/>
            <converters:ZDatumDisplayNameConverter x:Key="ZDatumDisplayName"/>
            <converters:EnumEqualsToBrushConverter x:Key="EnumEqualsToBrush"/>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:TitleBar/>
        <Border Grid.Row="1" Background="White" CornerRadius="15" Margin="20,12" Padding="18">
            <TabControl Style="{StaticResource PrimaryTabControlStyle}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" IsEnabled="{Binding IsInputEnabled, Mode=OneWay}">
                <TabItem Header="입력·기준점">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AddKindDropdownButton" Content="파일 추가 ▾" Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="SHP · DWG · DXF · 엑셀 · CSV" Click="AddKindDropdownButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="전체 형식" Command="{Binding AddCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="SHP (관로망)" Command="{Binding AddCommand}" CommandParameter="Shp"/>
                                        <MenuItem Header="DWG · DXF (도면)" Command="{Binding AddCommand}" CommandParameter="Dwg"/>
                                        <MenuItem Header="엑셀 · CSV (측점 좌표)" Command="{Binding AddCommand}" CommandParameter="Excel"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="제거" Style="{StaticResource CancelButtonStyle}" Margin="8,0" Command="{Binding RemoveCommand}"/>
                            <TextBlock Margin="18,5,0,0" Foreground="#B26B00" Text="{Binding DiameterUnresolvedCount, StringFormat=⚠ 확정 안 한 표기 {0}건}" ToolTip="확정하지 않으면 자동추정값으로 배치되며 규격표 조회에 실패할 수 있습니다" Visibility="{Binding HasDiameterUnresolved, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Margin="18,5,0,0" Foreground="#B26B00" TextWrapping="Wrap"
                                       Text="{Binding SpecUnmatchedCount, StringFormat=⚠ 규격 미매칭 {0}건}"
                                       ToolTip="직관 제원표에서 (등급, DN) 행을 찾지 못한 레코드입니다.&#10;OD·두께 매개변수가 기록되지 않고, 관저고·크라운 기준 높이는 호칭지름을 외경으로 간주한 값으로 보정됩니다.&#10;[규격 매핑] 탭에서 등급·확정 DN을 지정하거나, [관·곡관 규격표…]에 해당 DN 행을 추가하세요."
                                       Visibility="{Binding HasSpecUnmatched, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" Margin="0,10" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <Border Background="White" BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10" Visibility="{Binding HasShpFiles, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                            <TextBlock Text="SHP (관로망)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DataGrid x:Name="ShpGrid" ItemsSource="{Binding ShpFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일 (SHP)" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                    <DataGridTemplateColumn Header="직경 필드(DBF)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding DiameterField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관종 필드(DBF)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding KindField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" IsReadOnly="True" TextWrapping="Wrap" Height="80" Margin="0,8,0,0"
                                     Text="{Binding SelectedItem.Details, ElementName=ShpGrid, Mode=OneWay}"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" IsReadOnly="True" TextWrapping="Wrap" Height="60" Margin="0,8,0,0"
                                     Text="{Binding SelectedItem.ProjectionDetails, ElementName=ShpGrid, Mode=OneWay}"/>
                            </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10" Visibility="{Binding HasDwgFiles, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                            <TextBlock Text="DWG · DXF (도면)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DataGrid x:Name="DwgGrid" ItemsSource="{Binding DwgFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일 (DWG·DXF)" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                    <DataGridTemplateColumn Header="직경 필드(XDATA)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding DiameterField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관종 필드(XDATA)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding KindField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" IsReadOnly="True" TextWrapping="Wrap" Height="80" Margin="0,8,0,0"
                                     Text="{Binding SelectedItem.Details, ElementName=DwgGrid, Mode=OneWay}"/>
                            <TextBlock Margin="0,8,0,3" Text="사용할 폴리선 레이어 (복수 선택 가능)"/>
                            <ListBox ItemsSource="{Binding SelectedItem.LayerOptions, ElementName=DwgGrid, Mode=OneWay}" MaxHeight="100" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="6" Padding="10" Visibility="{Binding HasExcelFiles, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                            <TextBlock Text="엑셀 · CSV (측점 좌표)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DataGrid x:Name="ExcelGrid" ItemsSource="{Binding ExcelFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일 (Excel, 시트별)" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                    <DataGridTemplateColumn Header="직경 필드" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding DiameterField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관종 필드" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding KindField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" IsReadOnly="True" TextWrapping="Wrap" Height="80" Margin="0,8,0,0"
                                     Text="{Binding SelectedItem.Details, ElementName=ExcelGrid, Mode=OneWay}"/>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock Margin="0,8,0,3" TextWrapping="Wrap" Text="평면 기준점 X·Y (m, 소수 5자리=0.01mm) — 첫 파일 첫 정점에서 자동 산출하며 수정할 수 있습니다. 이 점이 프로젝트 기준점에 놓이고, 높이는 정점 Z값으로만 결정됩니다.&#10;아래 체크를 해제하면 이 값 대신 문서에 이미 설정된 공유좌표를 기준점으로 사용합니다(공유좌표가 없으면 실행 시 확인 후 원본 좌표 그대로 배치)."/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="170" Text="{Binding ReferenceX, StringFormat={}{0:0.00000}}"/>
                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="170" Margin="8,0" Text="{Binding ReferenceY, StringFormat={}{0:0.00000}}"/>
                            </StackPanel>
                            <CheckBox Content="프로젝트 공유좌표에도 기준점 적용 (해제 시 문서의 기존 공유좌표 또는 원본 좌표를 따름)" ToolTip="체크: 위 기준점을 프로젝트 공유좌표로 기록하고 그 점을 프로젝트 기준점에 놓습니다.&#10;해제: 문서에 이미 공유좌표가 있으면 그 좌표를 기준점으로 써 기존 모델과 위치를 맞추고, 없으면 확인 후 원본 좌표 그대로 배치합니다." Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding ApplySharedCoordinates}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="모델 유형 선택">
                    <StackPanel Margin="16">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="DirectShape (선형 형상)" IsChecked="{Binding IsDirectShape}" GroupName="Output"/>
                            <RadioButton Content="가변 패밀리 (직관 2점 + 곡관 5점)" Margin="18,0" IsChecked="{Binding IsAdaptive}" GroupName="Output"/>
                            <!-- TODO: 파이프(MEP) 미구현 상태라 임시로 숨김. 구현 완료 시 Visibility="Collapsed" 제거하면 됨. -->
                            <RadioButton Content="파이프 (MEP)" Margin="18,0" IsChecked="{Binding IsPiping}" GroupName="Output" Visibility="Collapsed"/>
                        </StackPanel>
                        <!-- DirectShape는 레벨·배치 간격·ZDatum을 사용하지 않고 원본 선형을 그대로 형상화한다. -->
                        <TextBlock Margin="0,16,0,5" Text="DirectShape는 선형 전체를 생성하고 DH_* 공유매개변수를 기록합니다." Visibility="{Binding IsDirectShape, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Visibility="{Binding IsAdaptive, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="관 배치 기준높이"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" Width="210" VerticalAlignment="Center" ItemsSource="{Binding ZDatums, Mode=OneWay}" SelectedItem="{Binding ZDatum, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ZDatumDisplayName}, Mode=OneWay}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Canvas Width="150" Height="110" Margin="18,0,0,0" IsHitTestVisible="False">
                                    <Ellipse Canvas.Left="5" Canvas.Top="15" Width="80" Height="80" Stroke="#52606A" StrokeThickness="2" Fill="#F7FAFC"/>
                                    <Ellipse Canvas.Left="20" Canvas.Top="30" Width="50" Height="50" Stroke="#7B8790" StrokeThickness="2" Fill="White"/>
                                    <Line X1="5" Y1="55" X2="85" Y2="55" Stroke="#7B8790" StrokeDashArray="3,2"/>
                                    <Line X1="45" Y1="15" X2="45" Y2="95" Stroke="#7B8790" StrokeDashArray="3,2"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="11" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=OutsideTop}"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="26" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=Crown}"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="51" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=Centerline}"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="76" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=Invert}"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="91" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=OutsideBottom}"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="7" FontSize="10" Text="외부 맨 위"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="23" FontSize="10" Text="크라운"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="48" FontSize="10" Text="중심선"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="73" FontSize="10" Text="관저고"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="89" FontSize="10" Text="외부 맨 아래"/>
                                </Canvas>
                            </StackPanel>
                            <TextBlock Text="직관 패밀리 : 유형 (2점 가변)"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding AdaptiveComponentTypeNames, Mode=OneWay}" SelectedItem="{Binding StraightFamilyTypeName, Mode=TwoWay}" ToolTip="직관은 Adaptive Point가 2개인 유형이어야 합니다."/>
                            <TextBlock Foreground="#B26B00" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding StraightPointCountNotice}" Visibility="{Binding HasStraightPointCountNotice, Converter={StaticResource BoolToVisibility}}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="직관 파라미터 매핑" FontWeight="SemiBold"/>
                                    <TextBlock Text="호칭지름 DN" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightParameterOptions, Mode=OneWay}" SelectedItem="{Binding StraightDiameterParameterName, Mode=TwoWay}"/>
                                    <TextBlock Text="외경 OD" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightParameterOptions, Mode=OneWay}" SelectedItem="{Binding StraightOuterDiameterParameterName, Mode=TwoWay}"/>
                                    <TextBlock Text="두께" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightParameterOptions, Mode=OneWay}" SelectedItem="{Binding StraightThicknessParameterName, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="곡관 파라미터 매핑" FontWeight="SemiBold"/>
                                    <TextBlock Text="호칭지름 DN" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding BendParameterOptions, Mode=OneWay}" SelectedItem="{Binding BendDiameterParameterName, Mode=TwoWay}"/>
                                    <TextBlock Text="벽두께 e" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding BendParameterOptions, Mode=OneWay}" SelectedItem="{Binding BendWallThicknessParameterName, Mode=TwoWay}"/>
                                    <TextBlock Text="외경 OD" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding BendParameterOptions, Mode=OneWay}" SelectedItem="{Binding BendOuterDiameterParameterName, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="배치 간격 (m)" Margin="0,8,0,3"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding IntervalM}" Width="150" HorizontalAlignment="Left" ToolTip="직관을 이 간격으로 분절해 배치합니다. 곡관이 들어가는 정점에서는 그 자리만큼 직관을 만들지 않습니다."/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsPiping, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="파이프 시스템"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipingSystemTypeNames}" SelectedItem="{Binding PipingSystemTypeName}"/>
                            <TextBlock Margin="0,8,0,0" Text="PipeType"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipeTypeNames}" SelectedItem="{Binding PipeTypeName}"/>
                            <TextBlock Text="레벨" Margin="0,12,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding LevelNames}" SelectedItem="{Binding LevelName}"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
                <TabItem Header="규격 매핑">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="원본값에서 발견한 직경 표기를 호칭지름 DN과 등급에 연결합니다. OD·두께는 [관·곡관 규격표]에서 자동으로 찾아온 값입니다."/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DiameterMappings, Mode=OneWay}" SelectionMode="Extended" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="원본값" Binding="{Binding RawValue, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="파일" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="건수" Binding="{Binding Count, Mode=OneWay}" IsReadOnly="True" Width="65"/>
                                <DataGridTextColumn Header="자동추정" Binding="{Binding AutoDiameterDisplay, Mode=OneWay}" IsReadOnly="True" Width="80"/>
                                <DataGridTemplateColumn Header="확정 DN" Width="120">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.DiameterOptions, Mode=OneWay, RelativeSource={RelativeSource AncestorType=DataGrid}}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedDiameterOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="등급" Width="130">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.MappingPipeKinds, Mode=OneWay, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding PipeKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="OD/thk" Binding="{Binding SpecificationDisplay, Mode=OneWay}" IsReadOnly="True" Width="90"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding Status, Mode=OneWay}" IsReadOnly="True" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox Width="150" ItemsSource="{Binding MappingPipeKinds, Mode=OneWay}" SelectedItem="{Binding BulkMappingPipeKind, Mode=TwoWay}"/>
                            <Button Grid.Column="1" Content="전체 일괄 적용" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Command="{Binding ApplyBulkMappingCommand}" ToolTip="확정 DN은 자동추정값으로, 등급은 왼쪽에서 고른 값으로 표의 모든 행에 적용합니다."/>
                            <!-- 관·곡관 규격표 진입점은 [관 · 곡관 설정] 탭 하나로 통일했다(2026-08-20, 중복 진입점 정리). -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Foreground="#B26B00" Text="{Binding DiameterUnresolvedCount, StringFormat=⚠ 확정 안 한 표기 {0}건}" ToolTip="확정하지 않으면 자동추정값으로 배치되며 규격표 조회에 실패할 수 있습니다"/>
                                <TextBlock Foreground="#B26B00" Margin="12,0,0,0" Text="{Binding SpecUnmatchedCount, StringFormat=⚠ 규격 미매칭 {0}건}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="선형 방향" Visibility="{Binding IsAlignmentDirectionVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="선형(레코드)마다 진행 방향을 지정합니다. [반전]을 체크하면 정점 순서가 뒤집혀 시작점과 끝점이 서로 바뀝니다(좌표값 자체는 변하지 않습니다). Ctrl·Shift로 여러 행을 선택한 뒤 그중 한 행의 [반전]을 클릭하면 선택한 행 전체가 같은 값이 됩니다. 진단과 모델링 모두 여기서 지정한 방향을 사용합니다."/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DirectionRows, Mode=OneWay}" SelectionMode="Extended" AutoGenerateColumns="False" CanUserAddRows="False"
                                  MaxHeight="400" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseLeftButtonDown="DirectionGrid_OnPreviewMouseLeftButtonDown">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="파일" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="레코드" Binding="{Binding RecordNumber, Mode=OneWay}" IsReadOnly="True" Width="80"/>
                                <DataGridTextColumn Header="시작 (X, Y, Z)" Binding="{Binding StartDisplay, Mode=OneWay}" IsReadOnly="True" Width="190"/>
                                <DataGridTextColumn Header="끝 (X, Y, Z)" Binding="{Binding EndDisplay, Mode=OneWay}" IsReadOnly="True" Width="190"/>
                                <DataGridTextColumn Header="정점" Binding="{Binding VertexDisplay, Mode=OneWay}" IsReadOnly="True" Width="60"/>
                                <DataGridTextColumn Header="길이(m)" Binding="{Binding LengthDisplay, Mode=OneWay}" IsReadOnly="True" Width="80"/>
                                <DataGridTemplateColumn Header="반전" Width="60">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsReversed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3A6EA5" Text="{Binding ReversedCount, StringFormat=방향 반전 {0}건}"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="관 · 곡관 설정" Visibility="{Binding IsAdaptive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="12">
                        <TextBlock Foreground="#B26B00" Text="{Binding SettingsNotice}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <Button Content="관·곡관 설정 열기…" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenPipeSpecsCommand}" ToolTip="직관 제원 · 곡관치수 · 허용굴곡을 한 창에서 편집합니다."/>
                        </StackPanel>
                        <TextBlock Text="곡관 접합 종류" Margin="0,14,0,3"/>
                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}"
                                  ItemsSource="{Binding BendConnectionOptions, Mode=OneWay}"
                                  SelectedItem="{Binding BendConnectionOption, Mode=TwoWay}"
                                  ToolTip="배치에 쓸 곡관 규격 계열입니다.&#10;플랜지곡관은 핸드북에 45°·90°만 있어, 완만한 굴곡 절점의 미해결 판정이 늘어날 수 있습니다."/>
                        <TextBlock Text="곡관 패밀리 : 유형" Margin="0,14,0,3"/>
                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding AdaptiveComponentTypeNames, Mode=OneWay}" SelectedItem="{Binding BendFamilyTypeName, Mode=TwoWay}" ToolTip="곡관은 Adaptive Point가 5개인 유형이어야 합니다."/>
                        <TextBlock Foreground="#B26B00" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding BendPointCountNotice}" Visibility="{Binding HasBendPointCountNotice, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="진단">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="스냅 허용오차(mm)" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="70" Margin="8,0" Text="{Binding SnapToleranceMm}"/>
                            <Button Content="진단 실행" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0" Command="{Binding RunCommand}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Margin="0,12,0,6" Text="{Binding Summary}" TextWrapping="Wrap"/>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Attention}" IsReadOnly="True" AutoGenerateColumns="True"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
        <Grid Grid.Row="2" Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
                <StackPanel Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="{Binding PhaseText, Mode=OneWay}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProgressDetail, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#52606A"/>
                    </Grid>
                    <ProgressBar Style="{StaticResource PrimaryProgressBarStyle}" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"/>
                </StackPanel>
                <Border Margin="0,8,0,0" Padding="10" Background="#FFF8E8" CornerRadius="6"
                        Visibility="{Binding HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ResultSummary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <ScrollViewer MaxHeight="110" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ResultWarnings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Mode=OneWay}" Foreground="#B26B00" TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="닫기" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Content="모델 생성" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateCommand}"
                        IsEnabled="{Binding IsInputEnabled, Mode=OneWay}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
