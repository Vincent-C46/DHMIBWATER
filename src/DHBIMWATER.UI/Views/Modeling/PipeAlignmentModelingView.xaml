<Window x:Class="DHBIMWATER.UI.Views.Modeling.PipeAlignmentModelingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls" Title="관로 모델링" Width="960" Height="700" WindowStartupLocation="CenterScreen" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" Background="#F4F7F9">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></ResourceDictionary></Window.Resources>
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><controls:TitleBar/>
    <Border Grid.Row="1" Background="White" CornerRadius="15" Margin="20,12" Padding="18"><TabControl Style="{StaticResource PrimaryTabControlStyle}">
      <TabItem Header="입력·기준점"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="파일 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}"/><Button Content="제거" Style="{StaticResource CancelButtonStyle}" Margin="8,0" Command="{Binding RemoveCommand}"/><TextBlock Margin="18,5,0,0" Foreground="#B26B00" Text="{Binding DiameterUnresolvedCount, StringFormat=⚠ 직경 미확인 {0}건}" Visibility="{Binding HasDiameterUnresolved, Converter={StaticResource BoolToVisibility}}"/></StackPanel><DataGrid Grid.Row="1" Margin="0,10" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="파일" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="관종(수동)" Binding="{Binding PipeKind}" Width="130"/><DataGridComboBoxColumn Header="직경 필드" SelectedItemBinding="{Binding DiameterField}" ItemsSource="{Binding Fields}" Width="130"/><DataGridComboBoxColumn Header="관종 필드" SelectedItemBinding="{Binding KindField}" ItemsSource="{Binding Fields}" Width="130"/></DataGrid.Columns></DataGrid><TextBox Grid.Row="2" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding SelectedFileDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="80"/><StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ProjectionDetails, Mode=OneWay}" IsReadOnly="True" Height="60" TextWrapping="Wrap"/><TextBlock Margin="0,8,0,3" Text="기준점 (m) — 첫 파일 첫 정점에서 자동 산출하며 수정할 수 있습니다."/><StackPanel Orientation="Horizontal"><TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="170" Text="{Binding ReferenceX}"/><TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="170" Margin="8,0" Text="{Binding ReferenceY}"/><TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="170" Text="{Binding ReferenceZ}"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" Width="140" Margin="8,0" ItemsSource="{Binding ZDatums}" SelectedItem="{Binding ZDatum}"/></StackPanel><CheckBox Content="프로젝트 공유좌표에도 기준점 적용" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding ApplySharedCoordinates}" Margin="0,8,0,0"/></StackPanel></Grid></TabItem>
      <TabItem Header="출력 설정"><StackPanel Margin="16"><StackPanel Orientation="Horizontal"><RadioButton Content="DirectShape (선형 형상)" IsChecked="{Binding IsDirectShape}" GroupName="Output"/><RadioButton Content="구조 프레임 (빔)" Margin="18,0" IsChecked="{Binding IsBeam}" GroupName="Output"/><RadioButton Content="파이프 (MEP)" Margin="18,0" IsChecked="{Binding IsPiping}" GroupName="Output"/></StackPanel><TextBlock Margin="0,16,0,5" Text="DirectShape는 선형 전체를 생성하고 DH_* 공유매개변수를 기록합니다." Visibility="{Binding IsDirectShape, Converter={StaticResource BoolToVisibility}}"/><StackPanel Visibility="{Binding IsBeam, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="빔 유형"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding BeamTypeNames}" SelectedItem="{Binding BeamTypeName}"/><CheckBox Content="선형 접선 방향 회전" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding AlignTangent}" Margin="0,8,0,0"/></StackPanel><StackPanel Visibility="{Binding IsPiping, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="파이프 시스템"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipingSystemTypeNames}" SelectedItem="{Binding PipingSystemTypeName}"/><TextBlock Margin="0,8,0,0" Text="PipeType"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipeTypeNames}" SelectedItem="{Binding PipeTypeName}"/></StackPanel><StackPanel Visibility="{Binding IsDirectShape, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="레벨" Margin="0,12,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding LevelNames}" SelectedItem="{Binding LevelName}"/><TextBlock Text="배치 간격 (m)" Margin="0,8,0,3"/><TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding IntervalM}" Width="150"/></StackPanel></StackPanel></TabItem>
      <TabItem Header="곡관 설정"><StackPanel Margin="12"><TextBlock Foreground="#B26B00" Text="{Binding SettingsNotice}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,8"><Button Content="허용굴곡 행 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddToleranceRowCommand}"/><Button Content="행 삭제" Style="{StaticResource CancelButtonStyle}" Margin="8,0" Command="{Binding RemoveToleranceRowCommand}"/></StackPanel><DataGrid Height="180" ItemsSource="{Binding Tolerances}" SelectedItem="{Binding SelectedTolerance}" AutoGenerateColumns="True"/><StackPanel Orientation="Horizontal" Margin="0,10,0,8"><Button Content="곡관 치수 행 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddFittingRowCommand}"/><Button Content="행 삭제" Style="{StaticResource CancelButtonStyle}" Margin="8,0" Command="{Binding RemoveFittingRowCommand}"/><Button Content="설정 저장" Style="{StaticResource PrimaryButtonStyle}" Margin="18,0" Command="{Binding SaveCommand}"/></StackPanel><DataGrid Height="180" ItemsSource="{Binding Fittings}" SelectedItem="{Binding SelectedFitting}" AutoGenerateColumns="True"/></StackPanel></TabItem>
      <TabItem Header="진단"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="스냅 허용오차(mm)" VerticalAlignment="Center"/><TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="70" Margin="8,0" Text="{Binding SnapToleranceMm}"/><TextBlock Text="곡관 형식" VerticalAlignment="Center"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" Width="100" Margin="8,0" ItemsSource="{Binding Forms}" SelectedItem="{Binding Form}"/><Button Content="진단 실행" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0" Command="{Binding RunCommand}"/></StackPanel><TextBlock Grid.Row="1" Margin="0,12,0,6" Text="{Binding Summary}" TextWrapping="Wrap"/><DataGrid Grid.Row="2" ItemsSource="{Binding Attention}" IsReadOnly="True" AutoGenerateColumns="True"/></Grid></TabItem>
    </TabControl></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16"><Button Content="취소" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/><Button Content="모델 생성" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateCommand}"/></StackPanel></Grid>
</Window>
