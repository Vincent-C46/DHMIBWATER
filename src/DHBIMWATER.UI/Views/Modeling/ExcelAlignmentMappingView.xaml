<Window x:Class="DHBIMWATER.UI.Views.Modeling.ExcelAlignmentMappingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls" Title="엑셀 데이터 매핑" Width="660" Height="760" WindowStartupLocation="CenterOwner" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" Background="#F4F7F9">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:TitleBar/>
        <Border Grid.Row="1" Background="White" CornerRadius="15" Margin="20,12" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource PrimaryBrush}" Text="파일 추가 · 엑셀 소스" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource SubHeadingTextBlockStyle}" Text="엑셀 데이터 매핑" Margin="0,2,0,2"/>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding FileName}" Margin="0,0,0,14"/>

                    <GroupBox Header="시트 선택 — 체크한 시트마다 관로 항목 1개씩 추가" Style="{StaticResource PrimaryGroupBox}" Margin="0,0,0,14">
                        <ItemsControl ItemsSource="{Binding Sheets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource PrimaryCheckBoxStyle}" Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,4,10,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Width="90" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="헤더 행"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding HeaderRow, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="데이터 시작 행"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding DataStartRow, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="미리보기 시트 (검증용 1개)"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding Sheets}" SelectedItem="{Binding PreviewSheet}" DisplayMemberPath="Name" MinWidth="180"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="미리보기"/>
                    <DataGrid Style="{StaticResource QuantityDataGridStyle}" ItemsSource="{Binding PreviewView}" AutoGenerateColumns="True" Height="170" Margin="0,0,0,14"/>

                    <GroupBox Header="열 지정" Style="{StaticResource PrimaryGroupBox}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource RequiredLabelTextBlockStyle}" Text="X" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,0,0,8" ItemsSource="{Binding ColumnOptions}" SelectedItem="{Binding XColumn}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource RequiredLabelTextBlockStyle}" Text="Y" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,0,0,8" ItemsSource="{Binding ColumnOptions}" SelectedItem="{Binding YColumn}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource RequiredLabelTextBlockStyle}" Text="Z" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,0,0,8" ItemsSource="{Binding ColumnOptions}" SelectedItem="{Binding ZColumn}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Station" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,0,0,8" ItemsSource="{Binding OptionalColumnOptions}" SelectedItem="{Binding StationColumn}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="직경" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,0,0,8" ItemsSource="{Binding OptionalColumnOptions}" SelectedItem="{Binding DiameterColumn}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="관종" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,0,0,8" ItemsSource="{Binding OptionalColumnOptions}" SelectedItem="{Binding KindColumn}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="피팅명" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="6" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding OptionalColumnOptions}" SelectedItem="{Binding FittingColumn}"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="취소" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
            <Button Content="확인" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OkCommand}" IsEnabled="{Binding CanConfirm}"/>
        </StackPanel>
    </Grid>
</Window>
