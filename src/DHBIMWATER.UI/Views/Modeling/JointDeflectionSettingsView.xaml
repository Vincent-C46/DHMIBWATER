<Window x:Class="DHBIMWATER.UI.Views.Modeling.JointDeflectionSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls" Title="허용굴곡 설정" Width="700" Height="560" WindowStartupLocation="CenterOwner" WindowStyle="None" Background="#F4F7F9">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:TitleBar/>
        <Border Grid.Row="1" Background="White" CornerRadius="15" Margin="20,12" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="적용 Joint Type"/>
                    <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding JointTypes, Mode=OneWay}" SelectedItem="{Binding ActiveJointType, Mode=TwoWay}" Margin="0,3,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Content="한쪽 Joint" IsChecked="{Binding IsSingleJoint, Mode=TwoWay}" GroupName="ApplicationMode"/>
                        <RadioButton Content="양쪽 Joint (θ₁+θ₂)" IsChecked="{Binding IsBothJoints, Mode=TwoWay}" GroupName="ApplicationMode" Margin="18,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="행 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}"/>
                        <Button Content="행 삭제" Style="{StaticResource CancelButtonStyle}" Margin="8,0" Command="{Binding RemoveCommand}"/>
                    </StackPanel>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Rows, Mode=OneWay}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Joint Type" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.JointTypes, Mode=OneWay, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding JointType, Mode=TwoWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="DN(mm)" Binding="{Binding DiameterMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="허용굴곡 θ(°)" Binding="{Binding AllowableDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <Button Content="기본값 복원" Style="{StaticResource CancelButtonStyle}" Command="{Binding RestoreCommand}" Margin="0,0,18,0"/>
            <Button Content="취소" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
            <Button Content="확인" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
