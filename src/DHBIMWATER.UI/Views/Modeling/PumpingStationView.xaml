                                                <TextBlock Text="진입부 내벽 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                                             Tag="T5" Text="{Binding T5}"
                                                             Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15" Visibility="{Binding T6Visibility}">
                                                <TextBlock Text="T6:" Style="{StaticResource LabelTextBlockStyle}" Width="35" VerticalAlignment="Center" />
                                                <TextBlock Text="와류방지벽 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                                             Tag="T6" Text="{Binding T6}"
                                                             Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="10,0,0,0" VerticalAlignment="Top">
                                <Image Source="{Binding PlanImagePath}" MaxWidth="900" Stretch="Uniform" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#EEF2F7" CornerRadius="8" Padding="15" Margin="10,0,0,0" VerticalAlignment="Top" MinWidth="260">
                                <StackPanel Width="240">
                                    <TextBlock FontSize="11" Foreground="#999" TextAlignment="Center" Margin="0,20,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HintTitle}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                                항목을 선택하면&#x0a;설명이 표시됩니다.
                                    </TextBlock>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HintTitle}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding HintTitle}" FontWeight="SemiBold" Foreground="#2C5F9E" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Separator Background="#C5D3E0" Height="1" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding HintDescription}" FontSize="11" Foreground="#444" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!--부재 유형 탭-->
