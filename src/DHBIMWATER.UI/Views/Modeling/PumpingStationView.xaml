<Window x:Class="DHBIMWATER.UI.Views.Modeling.PumpingStationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:PumpingStationViewModel, IsDesignTimeCreatable=False}"
        
        Title="DHBIM WATER - PumpingStation Builder"
        SizeToContent="Height" Width="1300" MinWidth="900" MaxWidth="1900" MinHeight="300"
        MaxHeight="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F9" 
        AllowsTransparency="False" 
        WindowStyle="None"
        FontFamily="Segoe UI, Malgun Gothic">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="30,10,30,10" Width="Auto">
            <Border Grid.Column="1"  Background="White" CornerRadius="15" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#DDE4EB" Opacity="0.3"/>
                </Border.Effect>
                <TabControl Style="{StaticResource PrimaryTabControlStyle}" Margin="20">
                    <!--
                    SelectionChanged="TabControl_SelectionChanged">
                    -->
                    <!--설계조건 탭-->
                    <TabItem Header="설계조건" Style="{StaticResource PrimaryTabItemStyle}">
                        <Grid GotFocus="OnParameterFocused" Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Excel 가져오기"
                                     Command="{Binding ImportExcelCommand}"
                                     Width="130" Height="20"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,10"/>
                                        <TextBox Text="{Binding ExcelFilePath, Mode=OneWay}" IsReadOnly="True" Margin="10,0,0,10" VerticalAlignment="Center"
                                             Width="170" BorderBrush="Transparent"
                                             Foreground="Gray"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="펌프 제작사" Style="{StaticResource LabelTextBlockStyle}" Width="130" VerticalAlignment="Center"/>
                                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}"
                                                      Width="170" Margin="10,0,0,0"
                                                      ItemsSource="{Binding PumpManufacturers}"
                                                      SelectedItem="{Binding SelectedPumpManufacturer}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <CheckBox IsChecked="{Binding HasCheckValve}" Margin="0,0,10,0" Content=" 추가역지밸브 적용" />
                                    </StackPanel>


                                    <Separator Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="펌프장 타입" Style="{StaticResource LabelTextBlockStyle}" Width="185" VerticalAlignment="Center"/>
                                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" 
                                             Width="100" Margin="10,0"
                                             ItemsSource="{Binding PumpingStaitonTypes}"
                                             SelectedItem="{Binding SelectedPumpingStationType}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="진입부 위치" Style="{StaticResource LabelTextBlockStyle}" Width="185" VerticalAlignment="Center"/>
                                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" 
                                             Width="100" Margin="10,0,0,5"
                                             ItemsSource="{Binding EntranceTypes}"
                                             SelectedItem="{Binding SelectedEntranceType}"/>
                                    </StackPanel>
                                    <Separator Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="D:" Style="{StaticResource LabelTextBlockStyle}" Width="35" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프 구경" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Tag="D" Text="{Binding D}"
                                                         Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="HD:" Style="{StaticResource LabelTextBlockStyle}" Width="35" VerticalAlignment="Center"/>
                                        <TextBlock Text="양정고" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Tag="HD" Text="{Binding HD}"
                                                         Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                        <TextBlock Text="m" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="N:" Style="{StaticResource LabelTextBlockStyle}" Width="35" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프 대수" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Tag="N" Text="{Binding N}"
                                                         Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                        <TextBlock Text="대" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="LWL:" Style="{StaticResource LabelTextBlockStyle}" Width="35" VerticalAlignment="Center"/>
                                        <TextBlock Text="저수위 (EL)" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Tag="LWL" Text="{Binding LWL}"
                                                         Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                        <TextBlock Text="m" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="HWL:" Style="{StaticResource LabelTextBlockStyle}" Width="35" VerticalAlignment="Center"/>
                                        <TextBlock Text="고수위 (EL)" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Tag="HWL" Text="{Binding HWL}"
                                                         Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                        <TextBlock Text="m" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,0,0,0">
                                <StackPanel>
                                    <Border Background="#EEF2F7" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="펌프장 타입" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                    <TextBlock Text="Type 1" HorizontalAlignment="Center" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                                                    <Image Source="pack://application:,,,/DHBIMWATER.UI;component/Resources/PumpStationImages/TYPE-1_종단개요.png" Stretch="Uniform"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                                    <TextBlock Text="Type 2" HorizontalAlignment="Center" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                                                    <Image Source="pack://application:,,,/DHBIMWATER.UI;component/Resources/PumpStationImages/TYPE-2_종단개요.png" Stretch="Uniform"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                                    <TextBlock Text="Type 3" HorizontalAlignment="Center" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                                                    <Image Source="pack://application:,,,/DHBIMWATER.UI;component/Resources/PumpStationImages/TYPE-3_종단개요.png" Stretch="Uniform"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#EEF2F7" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="진입부 위치" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                    <TextBlock Text="Type 1 · 좌안부" HorizontalAlignment="Center" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                                                    <Image Source="pack://application:,,,/DHBIMWATER.UI;component/Resources/PumpStationImages/TYPE-1_평면개요_좌안부.png" Stretch="Uniform"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                                    <TextBlock Text="Type 1 · 우안부" HorizontalAlignment="Center" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                                                    <Image Source="pack://application:,,,/DHBIMWATER.UI;component/Resources/PumpStationImages/TYPE-1_평면개요_우안부.png" Stretch="Uniform"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                                    <TextBlock Text="측면부" HorizontalAlignment="Center" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                                                    <Image Source="pack://application:,,,/DHBIMWATER.UI;component/Resources/PumpStationImages/TYPE-1_평면개요_측면부.png" Stretch="Uniform"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!--종단제원 탭-->
                    <TabItem Header="종단제원" Style="{StaticResource PrimaryTabItemStyle}">
                        <Grid GotFocus="OnParameterFocused" Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="B3:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                        <TextBlock Text="제진기 오프닝~건축격벽" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                                         Tag="B3" Text="{Binding B3}"
                                                         Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15" Visibility="{Binding B4Visibility}">
                                        <TextBlock Text="B4:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프 유지관리 공간 폭" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                                     Tag="B4" Text="{Binding B4}"
                                                     Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="θ:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                        <TextBlock Text="기초 경사부 기울기" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" 
                                                      Width="100" Margin="10,0"
                                                      ItemsSource="{Binding Thetas}"
                                                      SelectedItem="{Binding SelectedTheta}"/>
                                    </StackPanel>

                                    <Expander x:Name="DownExpander" Grid.Row="1"
                                               IsExpanded="{Binding IsExpanded}"
                                               ExpandDirection="Down">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="상세 설정"/>
                                            </StackPanel>
                                        </Expander.Header>

                                        <StackPanel>
                                            <!--
                                                <TextBlock Style ="{StaticResource PrimaryTextBlockStyle}" Text="고정값" Margin="10"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                    <TextBlock Text="T1:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                    <TextBlock Text="상부슬래브 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                    <TextBox Style="{StaticResource ReservoirTextBoxStyle}" 
                                                         Text="{Binding T1}" Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                    <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="50"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                    <TextBlock Text="T3:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                    <TextBlock Text="중간슬래브 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                    <TextBox Style="{StaticResource ReservoirTextBoxStyle}" 
                                                         Text="{Binding T3}" Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                    <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="50"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                    <TextBlock Text="B1:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                    <TextBlock Text="제진기 관리공간 폭" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                    <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                          Text="{Binding B1}"
                                          Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                    <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                    <TextBlock Text="L1:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                    <TextBlock Text="슬래브 단부 길이1" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                    <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                         Text="{Binding L1}"
                                         Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                    <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                    <TextBlock Text="OB1:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                    <TextBlock Text="벽체 오프닝 폭" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                    <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                          Text="{Binding OB1}"
                                          Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                    <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                    <TextBlock Text="OH1:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                    <TextBlock Text="벽체 오프닝 높이" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                    <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                          Text="{Binding OH1}"
                                          Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                    <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                    <TextBlock Text="H1:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                    <TextBlock Text="제진기 최소 운전 수위" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                    <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                         Text="{Binding H1}"
                                         Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                    <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                    <TextBlock Text="HS:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                    <TextBlock Text="계단 높이" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                    <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                                  Text="{Binding HS}"
                                                  Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                    <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                    <TextBlock Text="GB1" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                    <TextBlock Text= "거더 폭" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                    <TextBox Style="{StaticResource ReservoirTextBoxStyle}" 
                                         Text="{Binding GB1}" Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                    <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="50"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                    <TextBlock Text="GH1" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                    <TextBlock Text= "거더 높이" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                    <TextBox Style="{StaticResource ReservoirTextBoxStyle}" 
                                         Text="{Binding GH1}" Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                    <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="50"/>
                                                </StackPanel>

                                                <Separator Margin="0,0,0,10"/>


                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style ="{StaticResource PrimaryTextBlockStyle}" Text="계산값" Margin="10"/>
                                                    
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical">

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <TextBlock Text="B2:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                        <TextBlock Text="제진기 오프닝 길이" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                                             Text="{Binding B2}"
                                                             Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                        <TextBlock Text="" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                        <TextBlock Text="펌프 오프닝 타입" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                        <RadioButton Content="사각형" 
                                                                 IsChecked="{Binding IsRectangularOpening, Mode=TwoWay}"
                                                                 Margin="10,0" VerticalAlignment="Center"/>
                                                        <RadioButton Content="원형" 
                                                                 IsChecked="{Binding IsCircularOpening, Mode=TwoWay}"
                                                                 Margin="10,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <TextBlock Text="B5:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                        <TextBlock Text="펌프 오프닝 사이즈" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                                             Text="{Binding B5}"
                                                             Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <TextBlock Text="B6:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                        <TextBlock Text="돌출부 길이" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                                             Text="{Binding B6}"
                                                             Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <TextBlock Text="T2:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                        <TextBlock Text="기초슬래브 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                        <TextBox Style="{StaticResource ReservoirTextBoxStyle}" 
                                                             Text="{Binding T2}" Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="50"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <TextBlock Text="T4:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                        <TextBlock Text= "외벽 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                        <TextBox Style="{StaticResource ReservoirTextBoxStyle}" 
                                                             Text="{Binding T4}" Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="50"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <TextBlock Text="L2:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                        <TextBlock Text="슬래브 단부 길이2" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                                  Text="{Binding L2}"
                                                  Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <TextBlock Text="L3:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                        <TextBlock Text="기초 경사부 길이" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                                  Text="{Binding L3}"
                                                  Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
                                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="30"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <TextBlock Text="L4:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                        <TextBlock Text="계단 끝~펌프 중심" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                                                  Text="{Binding L4}"
                                                  Width="100" Margin="10,0" VerticalAlignment="Center" Height="25"/>
