<Window x:Class="DHBIMWATER.UI.Views.Modeling.WaterTankView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:WaterTankViewModel, IsDesignTimeCreatable=False}"
        
        Title="DHBIM WATER - WTank Builder" 
        Height="Auto" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F9" 
        AllowsTransparency="False" 
        WindowStyle="None"
        FontFamily="Segoe UI, Malgun Gothic">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" Grid.ColumnSpan="2"/>

        <Grid Grid.Row="1" Margin="30,10,30,10" Width="Auto">
            <Border Grid.Column="1" Background="White" CornerRadius="15" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#DDE4EB" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel Orientation="Vertical">
                    <TabControl Style="{StaticResource PrimaryTabControlStyle}" Margin="20" Height="Auto">
                        <!--Con'c 단면 탭-->
                        <TabItem Header="Con'c 단면" Style="{StaticResource PrimaryTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="450"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <!--수조부-->
                                            <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="수조부" FontSize="15" Margin="10"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="1-1." Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="상부 슬래브 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Width="100" Height="25" Margin="10,0"
                                                         Text="{Binding StuThk, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="1-2." Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="하부(기초) 슬래브 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Width="100" Height="25" Margin="10,0"
                                                         Text="{Binding StbThk, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="1-3." Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="외부 벽체 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Width="100" Height="25" Margin="10,0"
                                                         Text="{Binding WteThk, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="1-4." Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="내부 벽체 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Width="100" Height="25" Margin="10,0"
                                                         Text="{Binding WtiThk, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="1-5." Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="Hopper 벽체 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Width="100" Height="25" Margin="10,0"
                                                         Text="{Binding WhThk, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="1-6." Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="기둥 유형" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <ComboBox Width="200" Height="25" Margin="10,0" VerticalAlignment="Center"
                                                          ItemsSource="{Binding ColumnTypeNames}"
                                                          SelectedItem="{Binding ColumnTypeName, Mode=TwoWay}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="1-7." Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="보 유형" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <ComboBox Width="200" Height="25" Margin="10,0" VerticalAlignment="Center"
                                                          ItemsSource="{Binding BeamTypeNames}"
                                                          SelectedItem="{Binding BeamTypeName, Mode=TwoWay}"/>
                                            </StackPanel>

                                            <!--배관실-->
                                            <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="배관실" FontSize="15" Margin="10,15,10,10"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="2-1." Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="상부 슬래브 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Width="100" Height="25" Margin="10,0"
                                                         Text="{Binding SvuThk, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="2-2." Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="중간 슬래브 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Width="100" Height="25" Margin="10,0"
                                                         Text="{Binding SvmThk, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="2-3." Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="하부(기초) 슬래브 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Width="100" Height="25" Margin="10,0"
                                                         Text="{Binding SvbThk, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="2-4." Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="외부 벽체 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Width="100" Height="25" Margin="10,0"
                                                         Text="{Binding WveThk, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="2-5." Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="전기실 내벽 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Width="100" Height="25" Margin="10,0"
                                                         Text="{Binding WviThk, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!--공통-->
                                            <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="공통" FontSize="15" Margin="10,15,10,10"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="3-1." Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="버림 Con'c 두께" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Width="100" Height="25" Margin="10,0"
                                                         Text="{Binding LcThk, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <Image Source="pack://application:,,,/DHBIMWATER.UI;component/Resources/Images/3-1.부재선택.png"
                                                   Width="350"/>
                                            <Image Source="pack://application:,,,/DHBIMWATER.UI;component/Resources/Images/3-2.부재선택.png"
                                                   Width="350"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!--설계조건 탭-->
                        <TabItem Header="설계조건" Style="{StaticResource PrimaryTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="Q:" Style="{StaticResource LabelTextBlockStyle}" Width="35" VerticalAlignment="Center"/>
                                                <TextBlock Text="계획1일 최대급수량" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding Q, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment="Center"/>
                                                <TextBlock Text="㎥ / 일" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"
                                                           Width="50"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="RT:" Style="{StaticResource LabelTextBlockStyle}" Width="35" VerticalAlignment="Center"/>
                                                <TextBlock Text="최소 체류시간" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding RT}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment ="Center"/>
                                                <TextBlock Text="hr" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="N:" Style="{StaticResource LabelTextBlockStyle}" Width="35" VerticalAlignment="Center"/>
                                                <TextBlock Text="지 개수" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding N}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment ="Center"
                                                         IsReadOnly="True" Background="LightGray"/>
                                                <TextBlock Text="개" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="LWL:" Style="{StaticResource LabelTextBlockStyle}" Width="35" VerticalAlignment="Center"/>
                                                <TextBlock Text="저수위 (EL)" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding LWL}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment ="Center"/>
                                                <TextBlock Text="m" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="HWL:" Style="{StaticResource LabelTextBlockStyle}" Width="35" VerticalAlignment="Center"/>
                                                <TextBlock Text="고수위 (EL)" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding HWL}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment ="Center"/>
                                                <TextBlock Text="m" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <Image Source="pack://application:,,,/DHBIMWATER.UI;component/Resources/Images/0-1.설계조건.png"
                                                   Width="450"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!--수조부 탭-->
                        <TabItem Header="수조부" Style="{StaticResource PrimaryTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="He:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="유효수심 (HWL-LWL)" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding He, StringFormat={}{0:N3}, Mode=OneWay}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment="Center"
                                                         IsReadOnly="True" Background="LightGray"/>
                                                <TextBlock Text="m (자동계산)" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="150"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="Hf:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="여유고" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding Hf, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="150"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="Hm:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="수조부 바닥 ~ LWL 높이" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding Hm, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="150"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="W:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="지 폭" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding W, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="150"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="L:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="지 길이" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding L, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="150"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="체류시간:" Width="80" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}"
                                                           Text="{Binding CRT, StringFormat={}{0:N2}}"
                                                           Width="50" VerticalAlignment="Center" Foreground="#27AE60" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="hr  ≥  최소:" Width="Auto" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}"
                                                           Text="{Binding RT, StringFormat={}{0:0.###}}"
                                                           Width="35" VerticalAlignment="Center" Foreground="#27AE60" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="hr" Width="25" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}"
                                                           Text="{Binding RTCheck}"
                                                           Width="40" VerticalAlignment="Center" FontWeight="Bold"/>
                                            </StackPanel>

                                            <Separator/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="M:" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="기둥 Margin" Width="150" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="상(M1): " Width="50" VerticalAlignment="Center" Margin="10,0"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Text="{Binding M1, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="30" Height="25" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="mm /" Width="30" Margin="10,0" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="하(M2): " Width="50" VerticalAlignment="Center" Margin="10,0"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Text="{Binding M2, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="30" Height="25" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="mm" Width="30" Margin="10,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="" Width="180"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="좌(M3): " Width="50" VerticalAlignment="Center" Margin="10,0"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Text="{Binding M3, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="30" Height="25" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="mm /" Width="30" Margin="10,0" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="우(M4): " Width="50" VerticalAlignment="Center" Margin="10,0"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Text="{Binding M4, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="30" Height="25" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="mm" Width="30" Margin="10,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="" Width="180"/>
                                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="(기둥간 중심간격 5m 이내 등간격 자동배치)" Width="300" Margin="12,5,0,0"/>
                                            </StackPanel>

                                            <Separator/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="Wh:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="수조부 Hopper 폭" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding Wh, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="150"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="Lh:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="수조부 Hopper 길이" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding Lh, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="150"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="Hh:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="수조부 Hopper 깊이" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding Hh, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="150"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="Ltt:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="기초 Toe 길이" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding Ltt, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Width="150"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="SLv:" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                                <TextBlock Text="단차부 사면경사 1 : x (V:H)" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}"
                                                         Text="{Binding SLv, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Width="150" Margin="10,0" Height="25" VerticalAlignment="Center"/>
                                            </StackPanel>

                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <Image Source="pack://application:,,,/DHBIMWATER.UI;component/Resources/Images/1-1.수조부.png" Height="200"/>
                                            <Image Source="pack://application:,,,/DHBIMWATER.UI;component/Resources/Images/1-2.수조부.png" Height="200"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://application:,,,/DHBIMWATER.UI;component/Resources/Images/1-3.수조부.png" Width="100"/>
