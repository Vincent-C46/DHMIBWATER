<Window x:Class="DHBIMWATER.UI.Views.Modeling.PipeNetworkDiagnosisView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:gis="clr-namespace:DHBIMWATER.Core.Gis;assembly=DHBIMWATER.Core" Title="관로 네트워크 진단" Width="860" Height="640" WindowStartupLocation="CenterScreen" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" Background="#F4F7F9">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 표준 곡관 각도는 사용자 설정 대상이 아니라 고정 목록이다(BendToleranceTable.StandardAngles와 동일). -->
            <x:Array x:Key="StandardAngleList" Type="sys:Double">
                <sys:Double>11.25</sys:Double>
                <sys:Double>22.5</sys:Double>
                <sys:Double>45</sys:Double>
                <sys:Double>90</sys:Double>
            </x:Array>
            <ObjectDataProvider x:Key="BendFormList" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="gis:BendForm"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:TitleBar Grid.Row="0"/>
        <Border Grid.Row="1" Background="White" CornerRadius="15" Margin="20,12" Padding="18">
            <TabControl BorderThickness="0" Background="Transparent">

                <TabItem Header="진단">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="130"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Button Content="파일 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}"/>
                            <Button Content="제거" Style="{StaticResource CancelButtonStyle}" Margin="8,0,0,0" Command="{Binding RemoveCommand}"/>
                        </StackPanel>
                        <ListBox Grid.Row="1" Style="{StaticResource PrimaryListBoxStyle}" Margin="0,10,0,10" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FileName}" Width="380"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding PipeKind, UpdateSourceTrigger=PropertyChanged}" Width="180" ToolTip="파일별 관종"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="스냅 허용오차 (mm)" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="80" Margin="8,0,0,0" Text="{Binding SnapToleranceMm, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="곡관 형식" VerticalAlignment="Center" Margin="18,0,0,0"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" Width="100" Margin="8,0,0,0" ItemsSource="{Binding Forms}" SelectedItem="{Binding Form}"/>
                            <CheckBox Content="Diameter 속성 해석" Style="{StaticResource PrimaryCheckBoxStyle}" Margin="18,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ParseCombinedDiameter}"/>
                            <Button Content="진단 실행" Style="{StaticResource PrimaryButtonStyle}" Margin="18,0,0,0" Command="{Binding RunCommand}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Margin="0,10,0,6" TextWrapping="Wrap" Text="{Binding Summary}"/>
                        <DataGrid Grid.Row="4" ItemsSource="{Binding Attention}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#DDE3E8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="절점" Binding="{Binding NodeId}" Width="55"/>
                                <DataGridTextColumn Header="종류" Binding="{Binding Kind}" Width="105"/>
                                <DataGridTextColumn Header="차수" Binding="{Binding Degree}" Width="45"/>
                                <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=N3}" Width="90"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=N3}" Width="90"/>
                                <DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat=N3}" Width="70"/>
                                <DataGridTextColumn Header="편각°" Binding="{Binding DeflectionDeg, StringFormat=N2}" Width="60"/>
                                <DataGridTextColumn Header="관종" Binding="{Binding PipeKind}" Width="70"/>
                                <DataGridTextColumn Header="직경" Binding="{Binding MaxDiameterMm, StringFormat=N0}" Width="55"/>
                                <DataGridTextColumn Header="판정" Binding="{Binding BendResolution}" Width="85"/>
                                <DataGridTextColumn Header="표준각°" Binding="{Binding StandardAngleDeg, StringFormat=N2}" Width="65"/>
                                <DataGridTextColumn Header="잔차°" Binding="{Binding ResidualDeg, StringFormat=N2}" Width="60"/>
                                <DataGridTextColumn Header="t" Binding="{Binding LayingLengthMm, StringFormat=N0}" Width="55"/>
                                <DataGridTextColumn Header="R" Binding="{Binding CenterlineRadiusMm, StringFormat=N0}" Width="55"/>
                                <DataGridTextColumn Header="T" Binding="{Binding TangentLengthMm, StringFormat=N0}" Width="55"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="허용굴곡">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#B26B00" Text="{Binding SettingsNotice}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <Button Content="행 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddToleranceRowCommand}"/>
                            <Button Content="행 삭제" Style="{StaticResource CancelButtonStyle}" Margin="8,0,0,0" Command="{Binding RemoveToleranceRowCommand}"/>
                            <TextBlock Text="직경은 '이 직경 이하'를 포괄하는 구간 상한이다." VerticalAlignment="Center" Margin="18,0,0,0" Foreground="#7A8794"/>
                        </StackPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Tolerances}" SelectedItem="{Binding SelectedTolerance}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#DDE3E8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="관종 (빈칸=무관)" Binding="{Binding PipeKind, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                <DataGridTextColumn Header="직경 구간 상한 (mm)" Binding="{Binding DiameterMm, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                <DataGridTextColumn Header="허용굴곡 (°)" Binding="{Binding ToleranceDeg, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="곡관 치수">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#7A8794"
                                   Text="주철관 핸드북 곡관 치수표 기준. t = 절점에서 관 끝까지의 거리, R = 직선 사이에 들어가는 호의 반경. T = R·tan(θ/2)는 계산값이며 t &lt; T면 호가 관 밖으로 나간다(경고 후 진행). 미입력 시 직관 구간 차감 없음."/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <Button Content="행 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddFittingRowCommand}"/>
                            <Button Content="행 삭제" Style="{StaticResource CancelButtonStyle}" Margin="8,0,0,0" Command="{Binding RemoveFittingRowCommand}"/>
                        </StackPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Fittings}" SelectedItem="{Binding SelectedFitting}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#DDE3E8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="관종 (빈칸=무관)" Binding="{Binding PipeKind, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                <DataGridTextColumn Header="직경 상한 (mm)" Binding="{Binding DiameterMm, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridComboBoxColumn Header="각도 (°)" SelectedValueBinding="{Binding AngleDeg, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                        ItemsSource="{Binding Source={StaticResource StandardAngleList}}"/>
                                <DataGridComboBoxColumn Header="형식" SelectedValueBinding="{Binding Form, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                        ItemsSource="{Binding Source={StaticResource BendFormList}}"/>
                                <DataGridTextColumn Header="t (mm)" Binding="{Binding LayingLengthMm, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="R (mm)" Binding="{Binding CenterlineRadiusMm, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="T (계산)" Binding="{Binding TangentLengthMm}" IsReadOnly="True" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <Button Content="닫기" Style="{StaticResource CancelButtonStyle}" Command="{Binding CloseCommand}" Margin="0,0,8,0"/>
            <Button Content="설정 저장" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
