<Window x:Class="DHBIMWATER.UI.Views.Modeling.PipeLayoutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:converters="clr-namespace:DHBIMWATER.UI.Converters"
        xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PipeLayoutViewModel}"
        Title="DHBIM WATER - Pipe Layout" Width="1100" Height="720" WindowStartupLocation="CenterScreen"
        Background="#F4F7F9" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources><ResourceDictionary><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/><converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter"/><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:TitleBar Grid.Row="0"/>
        <Grid Grid.Row="1" Margin="20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="12" Padding="8" Margin="0,0,12,0"><Grid>
                <Canvas x:Name="LayoutCanvas" Background="#FCFDFE" Focusable="True" MouseLeftButtonDown="OnCanvasMouseLeftButtonDown" MouseMove="OnCanvasMouseMove" SizeChanged="OnLayoutCanvasSizeChanged">
                    <Line X1="{Binding ReferenceScreenX}" Y1="0" X2="{Binding ReferenceScreenX}" Y2="{Binding ActualHeight, ElementName=LayoutCanvas}" Stroke="#9ACD32" StrokeThickness="1.5" StrokeDashArray="4,3" IsHitTestVisible="False"/>
                    <Line X1="0" Y1="{Binding ReferenceScreenY}" X2="{Binding ActualWidth, ElementName=LayoutCanvas}" Y2="{Binding ReferenceScreenY}" Stroke="#9ACD32" StrokeThickness="1.5" StrokeDashArray="4,3" IsHitTestVisible="False"/>
                    <!-- 외곽 레이아웃: 내측면(진한 실선)이 기준면, 외측면(연한 선)은 벽 두께 표현 -->
                    <ItemsControl ItemsSource="{Binding OutlineWalls}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <Line X1="{Binding OuterX1}" Y1="{Binding OuterY1}" X2="{Binding OuterX2}" Y2="{Binding OuterY2}" Stroke="#C3CFD9" StrokeThickness="1"/>
                        <Line X1="{Binding InnerX1}" Y1="{Binding InnerY1}" X2="{Binding OuterX1}" Y2="{Binding OuterY1}" Stroke="#C3CFD9" StrokeThickness="1"/>
                        <Line X1="{Binding InnerX2}" Y1="{Binding InnerY2}" X2="{Binding OuterX2}" Y2="{Binding OuterY2}" Stroke="#C3CFD9" StrokeThickness="1"/>
                        <Line X1="{Binding InnerX1}" Y1="{Binding InnerY1}" X2="{Binding InnerX2}" Y2="{Binding InnerY2}" Stroke="#5D6D7E" StrokeThickness="2.5"/>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- IN/OUT 화살표: 좌·우 내측면 고정, 상하 위치만 사용자 지정 -->
                    <ItemsControl ItemsSource="{Binding OutlineArrows}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{Binding Color}" StrokeThickness="2.5"/>
                        <Polygon Points="{Binding HeadPoints}" Fill="{Binding Color}"/>
                        <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}" Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="{Binding Color}"/>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- 임시치수: 커서에서 X·Y 각 방향으로 가장 가까운 외곽선까지 -->
                    <ItemsControl ItemsSource="{Binding TempDimensions}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#8E44AD" StrokeThickness="1" StrokeDashArray="3,2"/>
                        <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}" Margin="2,-16,0,0" Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="#6C3483" Background="#FBF6FE"/>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- 표식기: TextBlock에 고정 Width/Height를 주면 글리프가 잘리므로, 클리핑하지 않는 Grid로 감싸고 안에서 중앙정렬한다. -->
                    <Grid Canvas.Left="{Binding SnapMarkerX}" Canvas.Top="{Binding SnapMarkerY}" Margin="-12,-12,0,0" Width="24" Height="24" IsHitTestVisible="False" Visibility="{Binding IsSnapMarkerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding SnapMarkerSymbol}" FontSize="18" FontWeight="Bold" Foreground="#00A651" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                    </Grid>
                    <Line X1="{Binding PreviewX1}" Y1="{Binding PreviewY1}" X2="{Binding PreviewX2}" Y2="{Binding PreviewY2}" Stroke="#E67E22" StrokeThickness="3" StrokeDashArray="6,3" IsHitTestVisible="False" Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Canvas.Left="{Binding PreviewLengthX}" Canvas.Top="{Binding PreviewLengthY}" Margin="4,-20,0,0" Text="{Binding PreviewLength}" FontSize="11" FontWeight="SemiBold" Foreground="#D35400" Background="#FFFCF8" IsHitTestVisible="False" Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- 부속 배치 미리보기: 리스트에서 패밀리를 고르면 커서가 붙는 선 위 지점에 도형 + 시작점부터의 임시치수를 보여준다 -->
                    <Line X1="{Binding FittingDimX1}" Y1="{Binding FittingDimY1}" X2="{Binding FittingDimX2}" Y2="{Binding FittingDimY2}" Stroke="#F39C12" StrokeThickness="1" StrokeDashArray="3,2" IsHitTestVisible="False" Visibility="{Binding IsFittingPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Canvas.Left="{Binding FittingPreviewX}" Canvas.Top="{Binding FittingPreviewY}" Margin="8,-18,0,0" Text="{Binding FittingDimLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#B9770E" Background="#FEF9E7" IsHitTestVisible="False" Visibility="{Binding IsFittingPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Grid Canvas.Left="{Binding FittingPreviewX}" Canvas.Top="{Binding FittingPreviewY}" Width="18" Height="18" Margin="-9,-9,0,0" IsHitTestVisible="False" Visibility="{Binding IsFittingPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Polygon Points="9,1 17,9 9,17 1,9" Fill="#F39C12" Stroke="White" StrokeThickness="1.5" Visibility="{Binding FittingPreviewShape, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Diamond}"/>
                        <Rectangle Width="14" Height="14" Margin="2" Fill="#2980B9" Stroke="White" StrokeThickness="1.5" Visibility="{Binding FittingPreviewShape, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Square}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Edges}" IsHitTestVisible="True"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas><Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{Binding Stroke}" StrokeThickness="4" MouseLeftButtonDown="OnEdgeMouseLeftButtonDown"/><TextBlock Canvas.Left="{Binding LengthX}" Canvas.Top="{Binding LengthY}" Margin="4,-20,0,0" Text="{Binding LengthLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#1B4F72" Background="#F8FBFD" IsHitTestVisible="False"/></Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- 배치된 부속: 배관 부속류=다이아몬드, 일반모델=사각형(P&ID 관습적 표기, 실제 패밀리 아이콘 대신 카테고리 도형만 표시) -->
                    <ItemsControl ItemsSource="{Binding InlineFittings}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="14" Height="14" Margin="-7,-7,0,0" ToolTip="{Binding FamilyTypeName}">
                            <Polygon Points="7,0 14,7 7,14 0,7" Fill="#F39C12" Stroke="White" StrokeThickness="1" Visibility="{Binding TypeKey, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=배관 부속류}"/>
                            <Rectangle Width="12" Height="12" Margin="1" Fill="#2980B9" Stroke="White" StrokeThickness="1" Visibility="{Binding TypeKey, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=일반모델}"/>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <ItemsControl ItemsSource="{Binding Nodes}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Margin="-7,-7,0,0"><Ellipse Width="14" Height="14" Fill="{Binding Color}" Stroke="White" StrokeThickness="2"/><TextBlock Text="{Binding Label}" FontSize="10" Foreground="#34495E"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </Canvas>
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#EAF2F8" CornerRadius="5" Padding="8"><TextBlock Text="연두색 십자선은 배관 X/Y 기준선이며, 근처점 선택 시 100mm 이내에서 스냅됩니다. 교차점은 원점(0,0)입니다. 노드: 회색 Cap · 파랑 Inline · 주황 Elbow · 보라 Tee · 빨강 Cross" FontSize="11"/></Border>
            </Grid></Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="외곽 레이아웃" FontWeight="Bold" Foreground="#4A6FA5" FontSize="16"/>
                <TextBlock Text="Revit에서 밸브실 외곽 벽체를 선택하면 벽 내측면이 기준선이 됩니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <Button Content="외곽 벽체 선택" Command="{Binding PickOutlineCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="외곽 지우기" Command="{Binding ClearOutlineCommand}" Style="{StaticResource CancelButtonStyle}" Margin="0,6,0,10"/>
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12" Visibility="{Binding HasOutline, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="IN / OUT 상하 위치" FontWeight="SemiBold" Foreground="#34495E"/>
                        <CheckBox Content="상단벽 기준으로 이격 (해제 시 하단벽)" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding ArrowFromTop}" Margin="0,6,0,6"/>
                        <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="IN" VerticalAlignment="Center" Foreground="#1E8449" FontWeight="SemiBold"/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding InOffsetMm, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="2" Text="mm" Margin="4,0"/></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="OUT" VerticalAlignment="Center" Foreground="#B03A2E" FontWeight="SemiBold"/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding OutOffsetMm, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="2" Text="mm" Margin="4,0"/></Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="인라인 부속품" FontWeight="Bold" Foreground="#4A6FA5" FontSize="16"/>
                <TextBlock Text="아래 목록에서 패밀리를 고른 뒤 선 위를 클릭하면 그 자리에 배치됩니다. Esc로 배치 모드를 취소합니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox Content="직교 + 45° 각도 스냅" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding UseAngleSnap}" Margin="0,0,0,8"/>
                        <TextBlock Text="OSNAP  ·  커서가 100mm 이내일 때 적용" FontWeight="SemiBold" Foreground="#34495E"/>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox Content="+ 기준점" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapReferencePoint}" Margin="0,0,10,5"/>
                            <CheckBox Content="□ 끝점" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapEndpoint}" Margin="0,0,10,5"/>
                            <CheckBox Content="△ 중간점" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapMidpoint}" Margin="0,0,10,5"/>
                            <CheckBox Content="◇ 사분점" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapQuadrant}" Margin="0,0,10,5"/>
                            <CheckBox Content="× 교차점" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapIntersection}" Margin="0,0,10,5"/>
                            <CheckBox Content="· 근처점" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapNearest}" Margin="0,0,10,0"/>
                        </WrapPanel>
                        <CheckBox Content="외곽선에도 OSNAP 적용" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapOutline}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="기준점 좌표" FontWeight="SemiBold"/>
                <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="X" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ReferenceX, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="2" Text="mm" Margin="4,0"/></Grid>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="Y" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ReferenceY, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="2" Text="mm" Margin="4,0"/></Grid>
                <TextBlock Text="출력 방식" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding OutputMode}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,8"/>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="표고" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding Elevation, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="2" Text="mm" Margin="4,0"/></Grid>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="관경" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding DiameterMm, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="2" Text="mm" Margin="4,0"/></Grid>
                <TextBlock Text="격자 스냅 단위 (직접 입력 가능)" FontWeight="SemiBold"/>
                <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                    <ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding GridSnapOptions}" Text="{Binding GridSnapMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Style="{StaticResource PrimaryComboBoxStyle}"/>
                    <TextBlock Grid.Column="1" Text="mm" Margin="4,0" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="부속 카테고리" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <RadioButton Content="배관 부속류" IsChecked="{Binding UseValveAccessoryCategory, Mode=TwoWay}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton Content="일반모델" IsChecked="{Binding UseGenericModelCategory, Mode=TwoWay}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="배치할 패밀리 (선택 후 선 위 클릭)" FontWeight="SemiBold"/>
                <ListBox Style="{StaticResource PrimaryListBoxStyle}" ItemsSource="{Binding FamilyTypeNames}" SelectedItem="{Binding SelectedFamilyTypeName}" Height="90" Margin="0,4,0,12"/>
                <TextBlock Text="배치된 부속품" FontWeight="Bold" Foreground="#4A6FA5" FontSize="16" Margin="0,0,0,4"/>
                <ListBox Style="{StaticResource PrimaryListBoxStyle}" ItemsSource="{Binding InlineFittings}" Height="220"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="3"><Button Content="삭제" Style="{StaticResource CancelButtonStyle}" DockPanel.Dock="Right" Command="{Binding DataContext.RemoveFittingCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding Order}" Width="24"/><TextBlock Text="{Binding TypeKey}" ToolTip="{Binding FamilyTypeName}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            </StackPanel></ScrollViewer></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="20,0,20,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="#34495E"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="그리기 취소" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelDrawingCommand}" Margin="0,0,8,0"/><Button Content="초기화" Style="{StaticResource CancelButtonStyle}" Command="{Binding ClearCommand}" Margin="0,0,8,0"/><Button Content="모델 생성" Command="{Binding CreateModelCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/><Button Content="닫기" Style="{StaticResource CancelButtonStyle}" Command="{Binding CloseCommand}"/></StackPanel></Grid>
    </Grid>
</Window>
